# ─── AdonisJS API — production ───────────────────────────────────────────────
# Copy to `.env` on the server and fill in. NEVER commit the real .env.

NODE_ENV=production
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# Generate a fresh one:  node ace generate:key
APP_KEY=

# Public origin of THIS api (e.g. https://api.sharkarijob.online)
APP_URL=https://api.sharkarijob.online

# Public origin of the FRONTEND. Used to build absolute sitemap/RSS URLs,
# so it must be the site domain, not the api domain.
SITE_URL=https://sharkarijob.online

SESSION_DRIVER=cookie

# ─── Database ────────────────────────────────────────────────────────────────
# Use 127.0.0.1 when the API runs on the same host as MySQL (preferred:
# no remote access, no firewall rule, nothing exposed).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Managed MySQL (Aiven, Cloud SQL, PlanetScale) requires TLS and presents its own
# CA. Paste that CA certificate (PEM) here. Leave empty for a local MySQL on
# 127.0.0.1. Hosts allowing only single-line values may escape the newlines.
DB_SSL_CA=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origins allowed to call this API, comma-separated, scheme included.
# REQUIRED in production -- unset blocks every browser request.
CORS_ORIGINS=https://sharkarijob.online,https://www.sharkarijob.online
# ─── Client IP / rate limiting ───────────────────────────────────────────────
# Everything that limits abuse (login, 2FA, registration, public form posts)
# counts per client IP, so this process has to resolve the real caller. Get it
# wrong and the limits either do nothing or lock out the whole site at once.
#
# TRUST_PROXY: which proxy may be believed about the caller's address.
#   loopback    (default) a reverse proxy on THIS box forwards to 127.0.0.1 --
#               nginx, Apache, or a hosting panel's Node app manager
#   false       nothing in front; this process is reached directly
#   <IP/CIDR>   one remote proxy, e.g. 10.0.0.8
TRUST_PROXY=loopback

# CLIENT_IP_HEADER: header naming the real client, set by a CDN in front.
# Behind Cloudflare that is cf-connecting-ip. Leave EMPTY unless the origin
# also refuses traffic that did not come through the CDN (firewall it to the
# CDN's ranges, or use a tunnel / authenticated origin pulls) -- otherwise
# anyone reaching this process directly can forge the header and sidestep
# every rate limit.
CLIENT_IP_HEADER=
